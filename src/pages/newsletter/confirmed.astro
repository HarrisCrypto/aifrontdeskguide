---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'You&rsquo;re subscribed · The Front Desk Brief',
  description: 'Your subscription to The Front Desk Brief is confirmed. One email a week, straight to your inbox.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement" />
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">Newsletter</p>
    <h1 class="font-headline mt-2 text-4xl font-bold md:text-5xl">You&rsquo;re in</h1>
    <p class="mt-4 text-lg text-muted">
      Your subscription to The Front Desk Brief is confirmed. One email a week: new AI receptionist launches, pricing
      changes worth knowing, and one practical takeaway for your business. No spam, and you can unsubscribe anytime
      from any issue.
    </p>
    <p class="mt-4 text-muted">While you wait for the next issue, the latest comparisons are a good place to start.</p>
    <a href="/comparisons/" class="btn-premium mt-8 inline-block">Read the latest comparisons</a>
  </section>
</Layout>
